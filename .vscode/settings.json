{
	"css.lint.unknownAtRules": "ignore",
	"editor.quickSuggestions": {
		"strings": true
	},
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"liveSassCompile.settings.formats": [
		{
			"format": "expanded",
			"extensionName": ".css",
			"savePath": "/.sass-output"
		}
	],
	"files.exclude": {
		".sass-output": true
	}
}
